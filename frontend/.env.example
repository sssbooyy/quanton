# Backend API origin (scheme + host + optional port). No trailing slash, no /api suffix
# unless your server is mounted that way.
#
# Vercel: Project → Settings → Environment Variables → add for Production (and Preview if needed).
#
# Local backend:
#   VITE_API_URL=http://localhost:5001
#
# Remote (ngrok, staging, prod API):
#   VITE_API_URL=https://your-api.example.com

VITE_API_URL=http://localhost:5001
