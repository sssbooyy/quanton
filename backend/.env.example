# Copy to .env and fill in values. On Render, set these in the dashboard (no file upload).

# --- HTTP ---
# Render injects PORT automatically. Local default is 5001 if unset.
# PORT=5001

# Comma-separated browser origins allowed to call this API (your Vite / SPA URLs).
# Required in production for browser-based Mini App + web clients.
# Example: https://quanton-market.vercel.app,https://quanton-git-preview.vercel.app
# Legacy single-origin alias (optional if CORS_ORIGINS is set):
# FRONTEND_URL=https://quanton-market.vercel.app
CORS_ORIGINS=http://localhost:5173

# --- Data (gifts.json) ---
# Default: ./data/gifts.json next to server.js (ephemeral on Render unless you use a Disk).
# Mount a Render Disk and point DATA_DIR at the mount path, e.g. /var/data/quanton
# DATA_DIR=/var/data/quanton
# Or set an explicit file path:
# GIFTS_JSON_PATH=/var/data/quanton/gifts.json

# --- Telegram ---
# BOT_TOKEN=123456:ABC...
# ADMIN_CHAT_ID=123456789
# Public HTTPS URL of the Mini App (Vercel / custom domain). No trailing slash.
# MINI_APP_URL=https://your-spa.example.com

# --- Node ---
# NODE_ENV=development
