# Copy to .env for local runs. On Render, set variables in the dashboard.

# --- MongoDB Atlas (required) ---
# SRV example: mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/quanton?retryWrites=true&w=majority
MONGODB_URI=

# --- HTTP ---
# Render sets PORT automatically. Local default is 5001 if unset.

# Browser origins allowed to call this API (comma-separated). Must include your Vercel URL.
CORS_ORIGINS=https://quanton-nine.vercel.app,http://localhost:5173

# Single-origin alias (optional if CORS_ORIGINS is set):
# FRONTEND_URL=https://quanton-nine.vercel.app

# --- Optional: gifts.json path (resolver + non-prod empty-DB demo seed; no auto Mongo seed in production) ---
# GIFTS_JSON_PATH=/absolute/path/to/gifts.json

# --- Telegram ---
# BOT_TOKEN=123456:ABC...
# ADMIN_CHAT_ID=123456789
# Same public URL as the Mini App (Vercel):
# MINI_APP_URL=https://quanton-nine.vercel.app

# --- Gift Asset API (Telegram gift metadata) ---
# https://github.com/GIFT-ASSET/gift_asset_api
# GIFT_ASSET_BASE_URL=https://giftasset.gifts
# GIFT_ASSET_API_KEY=
# GIFT_ASSET_AUTH_HEADER=X-API-Key

# --- Metadata refresh (cron / admin) ---
# Required in production for POST /gifts/:listingId/metadata/refresh and POST /gifts/metadata/sync-stale
# METADATA_SYNC_SECRET=

# --- Optional: AI image upscale (Real-ESRGAN via Replicate; OpenGraph + gift-asset rasters) ---
# REPLICATE_API_TOKEN=r8_...
# AI_UPSCALER_ENABLED=true
# Optional: override default nightmareai/real-esrgan Replicate **version** id (64-char hash):
# REPLICATE_REAL_ESRGAN_VERSION=f121d640bd286e1fdc67f9799164c1d5be36ff74576ee11c803ae5b665dd46aa
# Legacy (still supported): AI_UPSCALER_API_KEY, AI_UPSCALER_MODEL, AI_UPSCALER_PROVIDER=replicate
# AI_UPSCALER_MIN_EDGE_PX=480
# AI_UPSCALER_MAX_DOWNLOAD_BYTES=4500000
# AI_UPSCALER_DOWNLOAD_TIMEOUT_MS=12000
# AI_UPSCALER_JOB_TIMEOUT_MS=45000
# AI_UPSCALER_MAX_RETRIES=2

# --- Node ---
# NODE_ENV=development
