# Quanton Market — API base (no trailing slash).
#
# Vercel: `vercel.json` sets VITE_API_URL for production builds. Override in
# Vercel → Project → Settings → Environment Variables if the API host changes.
#
# Local development (Vite): defaults to http://localhost:5001 when unset.
#   VITE_API_URL=http://localhost:5001
#
# Staging / alternate API:
#   VITE_API_URL=https://your-api.onrender.com

# VITE_API_URL=https://quanton.onrender.com

# Escrow seller onboarding
# VITE_QUANTON_BOT_URL=https://t.me/QuantonMarketBot
# Temporary URL-based listings are enabled by default while escrow transfer is being connected.
# Set to false to hide the manual listing form.
# VITE_ENABLE_MANUAL_LISTING=true
# VITE_ENABLE_MANUAL_LISTING_FALLBACK=true
